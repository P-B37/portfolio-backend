# ==============================================================================
# Django Portfolio Backend - Environment Variables Template
# ==============================================================================
# Copy this file to a new file named '.env' in the same directory:
#   cp .env.example .env
# Replace the placeholder values with your actual configuration settings.
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# --- Domain Details ---
DOMAIN=localhost:8000
SITE_NAME=My-Portfolio

# --- Database Settings ---
# Defaults to SQLite if DB_ENGINE is empty/not set.
# To use PostgreSQL, set these variables:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Caching Settings ---
DISABLE_CACHE=True
CACHE_TIMEOUT=900

# --- Email (SMTP Configuration) ---
# To use Gmail SMTP with a secure App Password:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your Gmail address (e.g., bonheurndezenc@gmail.com)
EMAIL_HOST_USER=your_email@gmail.com

# Your 16-character Google App Password (NOT your normal Gmail password!)
# To generate one: 
# 1. Go to your Google Account (myaccount.google.com)
# 2. Select Security -> 2-Step Verification (must be enabled)
# 3. Scroll to the bottom and click "App passwords"
# 4. Select App: "Other (custom name)", enter "Portfolio", and click Generate.
# 5. Copy the 16-character password below (without spaces).
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop

# The destination address where you want to receive contact form submissions
ADMIN_EMAIL=your_email@gmail.com

# --- Media Storage (Cloudinary Integration) ---
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
